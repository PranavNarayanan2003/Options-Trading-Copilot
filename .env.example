# AI Options Trading Copilot V1.4.2
DATA_MODE=demo

# Alpaca market data
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_STOCK_FEED=iex
ALPACA_OPTION_FEED=indicative

# Telegram multi-user bot. Users self-subscribe with /start.
ENABLE_TELEGRAM=false
TELEGRAM_BOT_TOKEN=
# Optional: auto-subscribe your own chat on first boot.
TELEGRAM_BOOTSTRAP_CHAT_ID=

# Automatic news / macro awareness.
ENABLE_NEWS=true
# Optional but recommended for fuller scheduled FOMC/macro + monitored-stock earnings coverage.
TRADING_ECONOMICS_API_KEY=
ECONOMIC_CALENDAR_POLL_SECONDS=600

# AI final verification is OPTIONAL by default.
# Start with ENABLE_AI_REVIEW=false to validate the deterministic engine.
# When enabled, explicit AI VETO blocks; transient AI errors fail open by default.
# Set AI_REQUIRED_FOR_READY=true later only if you want strict fail-closed AI gating.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=none
OPENAI_TIMEOUT_SECONDS=3
ENABLE_AI_REVIEW=false
AI_REQUIRED_FOR_READY=false
AI_FAIL_OPEN_ON_ERROR=true

# Webull Singapore read-only owner sync (optional). This does NOT enable order placement.
ENABLE_WEBULL_SYNC=false
WEBULL_APP_KEY=
WEBULL_APP_SECRET=
WEBULL_ACCOUNT_ID=
WEBULL_REGION=sg
# Copy the API endpoint/host shown in your Webull OpenAPI dashboard.
WEBULL_API_ENDPOINT=
# Only needed if your Webull API setup requires an access token / 2FA token.
WEBULL_ACCESS_TOKEN=
WEBULL_POLL_SECONDS=15
# Prefer Webull's option snapshot bid/ask for the selected OCC contract.
# NOTE: Webull OpenAPI option quotes require the appropriate OpenAPI market-data entitlement.
ENABLE_WEBULL_QUOTES=false
WEBULL_QUOTES_REQUIRED_FOR_READY=false
WEBULL_OPTION_SNAPSHOT_PATH=/market-data/options/snapshots/list
WEBULL_MAX_QUOTE_AGE_SECONDS=20

# Public/cloud deployment
PUBLIC_BASE_URL=
# Protect private/admin endpoints. Generate a long random value in production.
ADMIN_TOKEN=
# On a VPS/Docker persistent volume you can point this to /data/alerts.sqlite3
DATABASE_PATH=

# Safety: remains recommendation-only.
ENABLE_BROKER_EXECUTION=false


